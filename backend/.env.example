# Server
HOST=0.0.0.0
PORT=1337

# Secrets — générer des valeurs aléatoires (ex. `openssl rand -base64 16`)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL du docker-compose)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=communaute
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Base recréée à chaque `npm test`
DATABASE_TEST_NAME=communaute_test

# Données de démonstration insérées au premier démarrage si la base est vide
SEED_DEMO_DATA=true
